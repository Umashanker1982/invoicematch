# Copy this file to .env and fill in your own values. .env is git-ignored.

# "claude" = use Claude through the SharedLLM gateway; "rules" = no AI, deterministic rules only.
LLM_MODE=claude

# SharedLLM gateway (course portal). Create a key at https://sharedllm.com/dashboard/keys
SHAREDLLM_KEY=
LLM_BASE_URL=https://api.sharedllm.com/anthropic
CLAUDE_MODEL=claude-haiku-5-5

# Request limits
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=1
